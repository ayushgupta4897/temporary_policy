# This file contains all Azure infrastructure and API configurations.
# Update this file to deploy to different Azure environments.
#
# IMPORTANT: This file contains secrets. Never commit to version control.
# ============================================================================

# ============================================================================
# AZURE INFRASTRUCTURE
# ============================================================================

# Azure Subscription & Location
AZURE_SUBSCRIPTION_ID=""
AZURE_LOCATION="eastus"

# Azure Resource Names
