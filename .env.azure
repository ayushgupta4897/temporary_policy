AZURE_STORAGE_ACCOUNT_NAME="policyaistorage"
AZURE_ENVIRONMENT_NAME="env-policy-ai-prod"
AZURE_CONTAINER_APP_NAME="ca-policy"

# ============================================================================
# APPLICATION SECRETS
# ============================================================================
# These will be injected as secrets into Azure Container Apps
# In production, consider using Azure Key Vault instead

# Azure Storage (for reports and artifacts)
# This will be auto-populated by deploy.sh after creating the storage account
# Or you can manually set it if you already have a storage account
AZURE_STORAGE_CONNECTION_STRING=""

# OpenAI API Key
OPENAI_API_KEY="sk-proj-v0UE1CYWcLznsQnCC7szZ4DFAArbeEeLdk4XGoUDASx6rfscI445p2o_91PrCQeGzyD3_oJj4uT3BlbkFJS4cP2VTetsnScq8DM2hX0NvrdWrPiXlNTCZCXPRS4ghO3eYxVwhHFKOor110IcPIlf39XEU"

# Application Password
POLICY_DRAFTER_PASSWORD="strategy2024"

# ============================================================================
# CONTAINER CONFIGURATION
# ============================================================================

# Backend Container Resources
BACKEND_CPU="4.0"
BACKEND_MEMORY="8.0Gi"
BACKEND_MIN_REPLICAS="1"
BACKEND_MAX_REPLICAS="10"
BACKEND_PORT="8000"

# Frontend Container Resources
FRONTEND_CPU="4.0"
FRONTEND_MEMORY="8.0Gi"
FRONTEND_MIN_REPLICAS="1"
FRONTEND_MAX_REPLICAS="5"
FRONTEND_PORT="3000"

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Environment Type (development, staging, production)
NODE_ENV="production"

# Backend URL - This will be auto-generated after first deployment
# Format: https://${AZURE_CONTAINER_APP_NAME}-backend.{environment-suffix}.{region}.azurecontainerapps.io
# Leave empty for first deployment, or set manually if you know the URL
BACKEND_URL="https://ca-policy-backend.happycliff-41c6de54.eastus.azurecontainerapps.io"

# ============================================================================
# NOTES
# ============================================================================
# 1. For first-time deployment: Leave BACKEND_URL empty. It will be discovered automatically.
# 2. For subsequent deployments: BACKEND_URL will be auto-populated from Azure.
# 3. To deploy to a new environment: Copy this file and update subscription, resource group, etc.
# 4. Security: Add .env.azure to .gitignore to prevent committing secrets.
# ============================================================================
