# ============================================================================
# Azure Environment Configuration - TEMPLATE
# Policy Intelligence Platform - Centralized Configuration
# ============================================================================
# This is a template file safe for version control.
# Copy this to .env.azure and fill in your actual values.
#
# USAGE:
#   cp .env.azure.example .env.azure
#   # Edit .env.azure with your actual values
#   ./deploy-cloudshell.sh
#
# For multiple environments:
#   cp .env.azure.example .env.pwc-prod
#   cp .env.azure.example .env.pwc-dev
#   # Edit each file with environment-specific values
#   cp .env.pwc-prod .env.azure && ./deploy-cloudshell.sh
# ============================================================================

# ============================================================================
# AZURE INFRASTRUCTURE
# ============================================================================

# Azure Subscription & Location
AZURE_SUBSCRIPTION_ID="<your-azure-subscription-id>"
AZURE_LOCATION="eastus"  # e.g., eastus, westus2, centralus

# Azure Resource Names
# NOTE: Registry and Storage names must be globally unique, lowercase, no special chars
AZURE_RESOURCE_GROUP="<your-resource-group>"  # e.g., rg-policy-intelligence-ai
AZURE_REGISTRY_NAME="<your-unique-registry-name>"  # e.g., crpolicyintel2025 (must be globally unique)
AZURE_STORAGE_ACCOUNT_NAME="<your-unique-storage-name>"  # e.g., policyaistorage (must be globally unique)
AZURE_ENVIRONMENT_NAME="<your-environment-name>"  # e.g., env-policy-ai-prod

# Container App Names (separate names for backend and frontend)
AZURE_BACKEND_APP_NAME="<your-backend-app-name>"  # e.g., ca-policy-backend
AZURE_FRONTEND_APP_NAME="<your-frontend-app-name>"  # e.g., ca-policy-frontend

# ============================================================================
# APPLICATION SECRETS
# ============================================================================
# These will be injected as secrets into Azure Container Apps
# In production, consider using Azure Key Vault instead

# Azure Storage (for reports and artifacts)
# Leave empty for first deployment - will be auto-populated by deploy script
# Or set manually if you already have a storage account
AZURE_STORAGE_CONNECTION_STRING=""

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="<your-openai-api-key>"

# Application Password
# Used for basic authentication to the application
POLICY_DRAFTER_PASSWORD="<your-secure-password>"

# ============================================================================
# CONTAINER CONFIGURATION
# ============================================================================

# Backend Container Resources
BACKEND_CPU="2.0"  # CPU cores (e.g., 0.5, 1.0, 2.0, 4.0)
BACKEND_MEMORY="4.0Gi"  # Memory (e.g., 1.0Gi, 2.0Gi, 4.0Gi, 8.0Gi)
BACKEND_MIN_REPLICAS="1"  # Minimum number of replicas (0 = scale to zero)
BACKEND_MAX_REPLICAS="10"  # Maximum number of replicas
BACKEND_PORT="8000"  # Internal port (do not change unless you modify the code)

# Frontend Container Resources
FRONTEND_CPU="1.0"  # CPU cores
FRONTEND_MEMORY="2.0Gi"  # Memory
FRONTEND_MIN_REPLICAS="1"  # Minimum number of replicas
FRONTEND_MAX_REPLICAS="5"  # Maximum number of replicas
FRONTEND_PORT="3000"  # Internal port (do not change unless you modify the code)

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Environment Type (development, staging, production)
NODE_ENV="production"

# Backend URL - Auto-generated after first deployment
# Format: https://${AZURE_CONTAINER_APP_NAME}-backend.{environment-suffix}.{region}.azurecontainerapps.io
# Leave empty for first deployment
BACKEND_URL=""

# Frontend URL - Auto-generated after frontend deployment
# Format: https://${AZURE_CONTAINER_APP_NAME}-frontend.{environment-suffix}.{region}.azurecontainerapps.io
# Used for CORS configuration
FRONTEND_URL=""

# ============================================================================
# NOTES FOR PWC CLOUD DEPLOYMENT
# ============================================================================
# 1. For first-time deployment: Leave BACKEND_URL and FRONTEND_URL empty.
#    They will be discovered automatically after deployment.
#
# 2. For subsequent deployments: URLs will be auto-populated from Azure.
#
# 3. To deploy to a new environment:
#    - Copy this file: cp .env.azure.example .env.pwc-prod
#    - Update subscription, resource group, and other values
#    - Copy to active config: cp .env.pwc-prod .env.azure
#    - Deploy: ./deploy-cloudshell.sh
#
# 4. Security Best Practices:
#    - NEVER commit .env.azure, .env.pwc-*, or any file with actual secrets
#    - Use Azure Key Vault for production secrets management
#    - Rotate API keys and passwords regularly
#
# 5. Resource Naming Requirements:
#    - AZURE_REGISTRY_NAME: lowercase, alphanumeric only, 5-50 chars, globally unique
#    - AZURE_STORAGE_ACCOUNT_NAME: lowercase, alphanumeric only, 3-24 chars, globally unique
#    - Other names: letters, numbers, hyphens allowed
# ============================================================================
